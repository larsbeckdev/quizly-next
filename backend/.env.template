# Copy this file to `.env.local` and adjust the values.
# Every value except GEMINI_API_KEY has a development fallback in
# core/settings.py.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins allowed to call this API with cookies.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Set to True when the API is served over HTTPS.
DJANGO_AUTH_COOKIE_SECURE=False
DJANGO_AUTH_COOKIE_SAMESITE=Lax

# Required for quiz generation. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Whisper model size: tiny, base, small, medium, large. Bigger is slower.
WHISPER_MODEL=base
