# Copy to .env and fill in DJANGO_SECRET_KEY and GEMINI_API_KEY. Compose
# reads .env automatically; every other value below has a default.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Required for quiz generation. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Whisper model size: tiny, base, small, medium, large. Bigger is more
# accurate and much slower on a CPU.
WHISPER_MODEL=base

# Host ports
API_PORT=3070
WEB_PORT=3071

# Django
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*

# Every worker keeps its own Whisper model in memory (base: ~1 GB), and a
# quiz request holds its worker until the quiz is done.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=900

# Only needed behind a TLS terminating proxy: the origin the admin login is
# submitted from, plus trusting the X-Forwarded-Proto header.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=0

# The auth cookies. Secure has to be True once the site runs on HTTPS.
DJANGO_AUTH_COOKIE_SECURE=False
DJANGO_AUTH_COOKIE_SAMESITE=Lax

# The frontend calls the API cross-origin with cookies, so CORS is always in
# play. True accepts every origin, which is what development in the local
# network needs. Set it to False on a public deployment and list the frontend
# origins below, scheme and host only, no path and no trailing slash.
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
DJANGO_CORS_ALLOWED_ORIGINS=

# Leave empty unless the API is not reachable at
# http://<host the frontend was opened from>:<API_PORT>/api, for example
# when a proxy in front puts it on a domain: https://api.example.com/api
# Keep the host name the same as the frontend's, the auth cookies are
# SameSite=Lax. Inlined at build time: change it, then docker compose build.
NEXT_PUBLIC_API_BASE_URL=
